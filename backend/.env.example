# PaymentsLab-KMP backend — environment variables.
# Copy to `.env` and fill with REAL values for a live deployment. All values below are PLACEHOLDERS.
# The server reads these via System.getenv(...) with safe test defaults (see ServerConfig.kt) — it
# never hardcodes a real secret. NEVER commit a real .env.

# Server
PORT=8080

# Razorpay — key_id is publishable (sent to client); SECRET and WEBHOOK_SECRET stay server-side.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe — publishable key is client-safe; SECRET stays server-side.
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxx

# Cashfree — app id + secret, both server-side for API auth.
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET=your_cashfree_secret
