<?xml version="1.0" encoding="utf-8"?>
<!--
  VAPT network posture (adapted from the Dice production app's pinned config).

  - base-config trusts ONLY the system CA store, NOT user-added CAs. This defeats the common MITM
    setup where an attacker (or a casual proxy like Charles/Burp) installs a custom root CA on the
    device — such certs are ignored app-wide. Cleartext is disabled by default.
  - The local dev backend (10.0.2.2 / localhost) is the one cleartext exception, scoped tightly.
  - Provider/API domains carry a pin-set. The pins here are PLACEHOLDERS — replace with real leaf +
    backup SPKI SHA-256 hashes before production (see core:security PaymentCertificatePinning for the
    openssl command). Demonstrative: the app talks to the local backend, not these domains directly.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <domain-config>
        <domain includeSubdomains="true">api.razorpay.com</domain>
        <domain includeSubdomains="true">api.stripe.com</domain>
        <domain includeSubdomains="true">sandbox.cashfree.com</domain>
        <pin-set expiration="2027-01-01">
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
