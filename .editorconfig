root = true

[*.{kt,kts}]
# @Composable functions are PascalCase by Compose convention — exempt them from function-naming.
ktlint_function_naming_ignore_when_annotated_with = Composable
# We deliberately group small related declarations per file (mappers, DI, small value types),
# so the one-public-class-per-file filename rule is too strict for this codebase.
ktlint_standard_filename = disabled
max_line_length = 120

# Never lint generated code (Room KSP _Impl / Constructor, etc.).
[**/build/**]
ktlint = disabled
